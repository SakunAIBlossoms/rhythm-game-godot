[sub_resource type="GDScript" id="GDScript_oyu2m"]
resource_name = "Ticker"
script/source = "extends RichTextLabel

var count = 3

func StartTickdown():
	$Timer.start(1)
	visible = true
	$Tick.play()

func _on_timer_timeout() -> void:
	count -= 1
	text = str(count)
	if count <= 0:
		$Timer.stop()
		visible = false
		count = 3
		get_parent().emit_signal(\"Unpause\")
		get_parent().visible = false
	else:
		$Tick.play()
"

