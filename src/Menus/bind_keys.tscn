[sub_resource type="GDScript" id="GDScript_oagup"]
resource_name = "DownscrollDetection"
script/source = "extends Control

var children = []

func _ready():
	children = get_children()

func _process(delta: float) -> void:
	var upscrollenabled = Config.GetOption(\"Upscroll\") if typeof(Config.GetOption(\"Upscroll\")) == TYPE_BOOL else false
	for child in children:
		for txt in child.get_children():
			var curkeytxt = txt.get_node(\"CurrentKey\")
			if upscrollenabled:
				curkeytxt.scale.y = -1
				curkeytxt.position.y = 85.
			elif not upscrollenabled:
				curkeytxt.scale.y = 1
				curkeytxt.position.y = 0.
		
		if upscrollenabled:
			child.scale.y = lerp(child.scale.y, -.711, 21*delta)
			child.position.y = lerp(child.position.y, 513., 21*delta)
		elif not upscrollenabled:
			child.scale.y = lerp(child.scale.y, .711, 21*delta)
			child.position.y = lerp(child.position.y, 0., 21*delta)
"

